{
  "name": "web-swing-escape-server",
  "version": "0.1.0",
  "private": true,
  "description": "Colyseus multiplayer server for Web Swing Escape (Unity 6 client).",
  "main": "build/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "tsx watch src/index.ts",
    "start:prod": "node build/index.js",
    "build": "tsc",
    "loadtest": "tsx loadtest/example.ts --room game --numClients 20 --endpoint ws://localhost:2567"
  },
  "dependencies": {
    "@colyseus/monitor": "^0.18.0",
    "@colyseus/playground": "^0.18.0",
    "@colyseus/tools": "^0.18.0",
    "colyseus": "^0.18.0"
  },
  "devDependencies": {
    "@colyseus/loadtest": "^0.18.0",
    "@colyseus/sdk": "^0.18.2",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
